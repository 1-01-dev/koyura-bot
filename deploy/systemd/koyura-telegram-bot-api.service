[Unit]
Description=Koyura Telegram Bot API server (telegram-bot-api)
Documentation=https://github.com/tdlib/telegram-bot-api
# Optional: only needed for uploads larger than 20 MB. When this unit is not
# used, point TELEGRAM_BOT_API_URL at https://api.telegram.org instead.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=koyura
Group=koyura
EnvironmentFile=/etc/koyura/koyura.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/var/lib/koyura
# TELEGRAM_API_ID / TELEGRAM_API_HASH come from /etc/koyura/koyura.env.
# --local raises the upload limit from 20 MB to 2 GB for self-hosted bots.
ExecStart=/usr/local/bin/telegram-bot-api \
    --local \
    --api-id=${TELEGRAM_API_ID} \
    --api-hash=${TELEGRAM_API_HASH} \
    --http-ip-address=127.0.0.1 \
    --http-port=8081 \
    --dir=/var/lib/koyura/bot-api
ExecStartPre=/bin/mkdir -p /var/lib/koyura/bot-api
Restart=always
RestartSec=10
TimeoutStopSec=30

StateDirectory=koyura

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
