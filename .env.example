# Koyura — environment template
#
# Copy to .env and fill in every value marked REQUIRED. Never commit .env.
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # secrets
#
# The same variables work for docker compose and for native venv/systemd runs.

# ---------------------------------------------------------------------------
# Telegram (REQUIRED)
# ---------------------------------------------------------------------------
# Bot token from @BotFather
BOT_TOKEN=
# API credentials from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Internal service authentication (REQUIRED)
# ---------------------------------------------------------------------------
# Shared secret between the bot, the dashboard and the media engine. The engine
# refuses /api/* requests without it. Generate one random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
# NEVER enable this outside a throwaway local sandbox.
INTERNAL_API_AUTH_DISABLED=false

# ---------------------------------------------------------------------------
# Admin dashboard (REQUIRED)
# ---------------------------------------------------------------------------
DASHBOARD_USER=admin
# Set either a plain password (min 8 chars) or a PBKDF2 hash, not both.
# Generate a hash: docker compose run --rm dashboard python -m hash_password
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_HASH=
# Cookie/login signing key, minimum 32 random characters. Required.
DASHBOARD_SECRET_KEY=
# Host port for the dashboard. It is always bound to 127.0.0.1.
DASHBOARD_PORT=8080
# Session lifetime in seconds (default 12h).
SESSION_MAX_AGE_SECONDS=43200
# auto = Secure cookie whenever the request is HTTPS; true/false force it.
SESSION_COOKIE_SECURE=auto
# Failed login attempts allowed per client address inside the window.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Only enable when a trusted reverse proxy sets X-Forwarded-* headers.
TRUST_PROXY_HEADERS=false
# Public panel address a phone can open (DASHBOARD_URL is the internal compose
# one). Only users in PRIVILEGED_USER_IDS get the link in a "cookies required"
# message. Leave empty to never link the panel from the chat.
DASHBOARD_PUBLIC_URL=
# Telegram user ids allowed to see that link, comma separated.
PRIVILEGED_USER_IDS=

# ---------------------------------------------------------------------------
# Where the engine finds the panel
# ---------------------------------------------------------------------------
# The engine asks the panel for the egress (proxy) rule and for the order of the
# cookie jars. Two names are read, in this order:
#   KOYURA_DASHBOARD_URL  the engine's own name; wins when both are set
#   DASHBOARD_URL         the name the bot and every native /etc/koyura/koyura.env
#                         already use — also the one below
# Neither set falls back to the compose service address http://dashboard:8080.
# A native install must name the address the panel really listens on
# (e.g. http://127.0.0.1:8090): the compose host name does not resolve there,
# and the engine then ran with no proxy and no cookie order at all.
DASHBOARD_URL=http://dashboard:8080

# ---------------------------------------------------------------------------
# Media engine
# ---------------------------------------------------------------------------
# Internal address; never published to the host by compose.
KOYURA_ENGINE_URL=http://koyura-engine:8899
# Engine bind address (127.0.0.1 for native runs behind a local proxy)
HOST=0.0.0.0
PORT=8899
# ---------------------------------------------------------------------------
# Download queue and limits
# ---------------------------------------------------------------------------
# Slots running at once. yt-dlp + ffmpeg are CPU-bound: one slot per vCPU is
# the sweet spot, more only make every download slower.
MAX_CONCURRENT_DOWNLOADS=2
# One user must not be able to occupy the queue: 1 active and 1 waiting job.
PER_USER_MAX_ACTIVE=1
PER_USER_MAX_QUEUED=1
# Hard cap on waiting jobs (0 disables queueing entirely).
MAX_QUEUE_LENGTH=6
# A new job is refused instead of queued when its predicted wait exceeds this.
QUEUE_MAX_WAIT_SECONDS=120
# Fallback throughput and fixed overhead used until real timings exist.
QUEUE_ESTIMATE_MBPS=2
QUEUE_ESTIMATE_OVERHEAD_SECONDS=6
# A job that waits longer than this is dropped with a readable error.
QUEUE_EXPIRY_SECONDS=120
DOWNLOAD_TIMEOUT=900
INFO_TIMEOUT=60
# Refuse larger files (MB, 0 = unlimited) and longer videos (seconds, 0 = off)
MAX_FILESIZE_MB=2000
MAX_DURATION_SECONDS=7200
# How long a finished job stays queryable in memory
JOB_TTL_SECONDS=3600
# Engine state directory: holds the queue throughput EWMA. Never point this at
# DOWNLOADS_PATH — the bot's cleanup and the panel's purge delete files there.
KOYURA_STATE_DIR=/var/lib/koyura
# Optional explicit path for the EWMA file (wins over KOYURA_STATE_DIR).
# QUEUE_STATS_PATH=/var/lib/koyura/koyura_queue_stats.json
# HLS downloader. "native" (default) reports live progress; "ffmpeg" works
# around X/Twitter fragment stalls but never reports progress, so the bot's
# progress card can then only show the downloaded amount.
HLS_DOWNLOADER=native

# ---------------------------------------------------------------------------
# Conversion (AV1/VP9 -> H.264)
# ---------------------------------------------------------------------------
# Telegram never re-encodes an upload: only MP4/H.264+AAC plays everywhere,
# and VP9/AV1 can show a broken frame on iPhone. Converting costs ~180% CPU on
# a two-vCPU host, so the default is NOT to convert: the bot offers H.264 first,
# labels the other formats, and sends them as a document — or asks once.
#   off    - never convert (default)
#   auto   - convert only files up to TRANSCODE_MAX_MB, ask above it
#   always - convert every AV1/VP9/VP8 file (the historical behaviour)
# The user's own "Convert" tap works in every mode, including off.
TRANSCODE_MODE=off
# Size ceiling for TRANSCODE_MODE=auto, in MB.
TRANSCODE_MAX_MB=300
# Optional path for the conversion-time EWMA behind the "Convert (~N min)"
# estimate. Defaults to $KOYURA_STATE_DIR/koyura_transcode_stats.json.
# TRANSCODE_STATS_PATH=/var/lib/koyura/koyura_transcode_stats.json

# ---------------------------------------------------------------------------
# Streaming links (Spotify, Apple Music, Deezer)
# ---------------------------------------------------------------------------
# Those catalogues are DRM-only: yt-dlp refuses them by design, so the link can
# never be the file. The engine reads the track's metadata from the service
# (oEmbed / iTunes lookup / Deezer API — all public, no key), searches for the
# same recording on YouTube and falls back to SoundCloud, and the chat offers the
# matches as numbered buttons. The user sees a track, not a substitution.
#   auto - resolve a track link to a downloadable version (default)
#   off  - refuse it with "not supported", the behaviour before this existed
TRACK_SUBSTITUTE=auto
# Per-service override of TRACK_SUBSTITUTE.
# SPOTIFY_SUBSTITUTE=auto
# APPLE_MUSIC_SUBSTITUTE=auto
# DEEZER_SUBSTITUTE=auto
# How long a resolved track (metadata + alternatives) is reused. 0 disables the
# cache, so every card costs a fresh search.
TRACK_CACHE_TTL_SECONDS=600
# yt-dlp's YouTube player clients, used for the search that finds a track's
# alternatives and for opening (and downloading) the one that is picked.
# YouTube answers some videos with "The following content is not available on
# this app" to the clients yt-dlp tries first; `android` does not get that
# refusal, but on its own it only exposes the muxed 360p stream, which would cost
# the video picker its resolutions. A list is therefore the default: yt-dlp
# merges the clients' format lists, so `default` still provides the full ladder
# where it works and `android` fills in the rest.
#   default,android - both, in that order (default)
#   default         - yt-dlp's own choice; the old behaviour
#   android         - widest coverage, 360p ceiling for video
YOUTUBE_PLAYER_CLIENT=default,android

# ---------------------------------------------------------------------------
# Bot uploads
# ---------------------------------------------------------------------------
# Largest file the bot offers and uploads, in MB. 2000 is the ceiling of the
# self-hosted Bot API; use 20 on the public api.telegram.org. A format whose
# known size is above this is not offered in the keyboard at all.
MAX_SEND_MB=2000

# ---------------------------------------------------------------------------
# Cleanup (shared downloads volume)
# ---------------------------------------------------------------------------
CLEANUP_MAX_AGE_HOURS=1
CLEANUP_MAX_DISK_MB=5000
CLEANUP_INTERVAL_SECONDS=300
# Never delete files modified within this window (in-flight downloads)
CLEANUP_ACTIVE_GRACE_SECONDS=300

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Docker volume mounts; for native runs point both services at one directory.
DOWNLOADS_PATH=/downloads
# Dashboard SQLite database
DB_PATH=/data/koyura_bot.db
# Service cookie jars (Netscape format), written by Admin -> Cookies and read by
# the engine. Deliberately outside DOWNLOADS_PATH: the bot's cleanup and the
# panel's purge delete files there, and a sign-in session must survive a purge.
# The directory is created on first upload, mode 0700, files 0600.
COOKIES_PATH=/var/lib/koyura2/cookies
# Outbound egress: the panel writes wg0.conf and secrets/<id>.txt here and reads
# the status.json that the host's koyura-egress.path watcher writes back. Shared
# by the panel and the engine (which only reads it). Not in DOWNLOADS_PATH, for
# the same reason the cookie tree is not: the config carries a private key and
# the secrets tree holds the proxy passwords (0600, one file per connection).
EGRESS_PATH=/var/lib/koyura2/egress
# How often the panel re-tests the proxy connections, in minutes (Admin -> Proxy
# stores the same value as proxy.test_interval). Leave it unset to let the page
# decide; set it to `off` to pin the automatic tests off on this server even if a
# page later sets an interval. The engine never runs these — it only reads
# GET /api/egress.
# PROXY_TEST_INTERVAL=off
# Bot preference store (survives restarts)
BOT_STATE_DB_PATH=/data/koyura_bot_state.db
# Mark downloads left "started"/"downloading" as failed on dashboard start
MARK_STALE_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
# Images are pulled from ghcr.io/<GHCR_OWNER>/koyura-bot/<service>.
GHCR_OWNER=1-01-dev
IMAGE_TAG=latest
LOG_LEVEL=INFO
